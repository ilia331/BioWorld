# Пример за настройки. Копирай този файл като .env и попълни стойностите.
# Самият .env НЕ се качва в GitHub (виж .gitignore).
#
# В браузъра се използва САМО публичният (publishable) ключ — той е защитен с RLS.
# Тайният ключ (sb_secret_...) НИКОГА не се слага в кода на сайта.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
